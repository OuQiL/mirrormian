# OpenAI 兼容端点（小米 MiMo 用 https://api.xiaomimimo.com/v1，模型 mimo-v2.5）
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=mimo-v2.5

# Embedding（可选，硅基流动示例：BAAI/bge-m3 免费）
LLM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LLM_EMBEDDING_API_KEY=sk-xxxx
LLM_EMBEDDING_MODEL=BAAI/bge-m3

# SQLite 路径
MIRROR_DB_PATH=data/mirror-mian.db

# ---- 部署（Cloudflare Tunnel，可选）----
# 在 https://one.dash.cloudflare.com → Zero Trust → Networks → Tunnels 创建隧道后得到的 Token。
# docker-compose 中 cloudflared 站在内网指向 app:8012，即可把站点挂到你的域名。
# CLOUDFLARE_TUNNEL_TOKEN=
